    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const fromObj = ($json.from && $json.from.value && $json.from.value[0]) || {};\nconst senderNameRaw = fromObj.name || fromObj.address || '';\nconst senderEmail = fromObj.address || '';\n\nconst subject = $json.subject || '(no subject)';\nconst rawDate = $json.date || new Date().toISOString();\n// Convert to Philippine time (Asia/Manila, UTC+8) so folder dates match local calendar day\nconst dateReceived = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Manila' }).format(new Date(rawDate));\n\nfunction sanitize(str) {\n  return String(str).replace(/[\\\\/:*?\"<>|]/g, '-').trim() || 'Unknown';\n}\n\nreturn {\n  json: {\n    senderName: sanitize(senderNameRaw),\n    senderEmail,\n    subject,\n    dateReceived,\n    label: sanitize($json.label),\n    attachmentCount: Object.keys($binary || {}).length\n  },\n  binary: $binary\n};"
      },
