    {
      "parameters": {
        "jsCode": "const output = [];\nconst items = $input.all();\n\nfor (let i = 0; i < items.length; i++) {\n  const folderId = items[i].json.id;\n  const extractItem = $('Extract Sender & Label Info').itemMatching(i);\n  const binaryKeys = Object.keys(extractItem.binary || {});\n\n  for (const key of binaryKeys) {\n    const bin = extractItem.binary[key];\n    output.push({\n      json: {\n        fileName: (bin && bin.fileName) || `${key}.dat`,\n        folderId\n      },\n      binary: { data: bin }\n    });\n  }\n}\n\nreturn output;"
      },
